{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GhostESP-Revival/ghostesp-apps/blob/main/schemas/catalog-manifest.schema.json",
  "title": "GhostESP catalog manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "authors",
    "category",
    "description",
    "type",
    "targets",
    "license",
    "source_repo",
    "source_branch",
    "source_subdir"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:-[0-9A-Za-z.-]+)?$"},
    "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "category": {"enum": ["System", "Tools", "Games", "Bluetooth", "GPIO", "Infrared", "Media", "NFC", "RFID", "Sub-GHz", "USB"]},
    "description": {"type": "string", "minLength": 1},
    "type": {"const": "app"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["esp32", "esp32s2", "esp32s3", "esp32c5", "esp32c6"]}
    },
    "license": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*$"},
    "source_repo": {"type": "string", "pattern": "^https://github\\.com/[^/\\s]+/[^/\\s]+?(?:\\.git)?$"},
    "source_branch": {"type": "string", "minLength": 1},
    "source_subdir": {
      "oneOf": [
        {"const": "."},
        {"type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"}
      ]
    },
    "screenshots": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["path", "alt"],
        "properties": {
          "path": {"type": "string", "pattern": "^screenshots/[A-Za-z0-9._/-]+\\.(?:[Pp][Nn][Gg]|[Jj][Pp][Ee]?[Gg]|[Ww][Ee][Bb][Pp])$"},
          "alt": {"type": "string", "minLength": 1},
          "caption": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "changelog": {"type": "string"},
    "reviewed": {"type": "boolean"}
  },
  "additionalProperties": false
}
